{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promtek-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promtek-hub",
      "database_id": "509d8b0e-8b6a-4acb-9707-6b9f949195d5"
    }
  ],

  "triggers": { "crons": ["*/2 * * * *"] },

  "observability": { "enabled": true },

  "vars": {
    "JIRA_BASE_URL": "https://promtek.atlassian.net",
    "JIRA_EMAIL": "owen.hume@promtek.com",
    "ALLOWED_EMAIL_DOMAIN": "promtek.com",
    "ADMIN_EMAILS": "owen.hume@promtek.com",

    "ACCESS_TEAM_DOMAIN": "https://promtek-hub.cloudflareaccess.com",
    "ACCESS_AUD": "96dedb5ede8c5c733e3d66d48b7340a39b5d7b3bbb603ca3fa63a57f6a5af3ea",

    "PROFILE_PROJECT": "DNM",
    "PROFILE_ISSUETYPE": "Employee",
    "USERID_FIELD_NAME": "UserID",
    "FIELD_ELO": "customfield_15378",
    "FIELD_BASELINE": "customfield_16566",
    "FIELD_XP_OVERRIDE": "customfield_16566",
    "FIELD_TOTAL_XP": "customfield_16499",

    "DRIVE_FOLDER_ID": "14T2Tk1YjLt0yEiO9m_Q-zWkP__n3X578",
    "EIGHT8_PBX_ID": "promteklimited",
    "BITBUCKET_WORKSPACE": "promtek"
  }
}

{
  "id": "/",
  "name": "Promtek Hub",
  "short_name": "Promtek",
  "description": "Promtek's app for XP, time and engineering tools.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0E6293",
  "theme_color": "#0E6293",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My XP", "url": "/#/xp", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "My time", "url": "/#/time", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
